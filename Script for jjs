-- ========== ПЕРСОНАЖИ: GOJO И YUJI ==========
-- Ходы ищутся по ключевым словам в названиях инструментов из рюкзака.
-- Слот хотбара определяется по порядку инструмента в рюкзаке.
local SLOT_KEYS = {
    Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four,
    Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight,
    Enum.KeyCode.Nine, Enum.KeyCode.Zero,
}
local Moves = {}

local function scanMoves(force)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return end
    -- Если инструмент в руках, порядок слотов не пересчитываем
    if not force and char and char:FindFirstChildOfClass("Tool") then return end
    local list = {}
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") then
            list[#list + 1] = { name = t.Name, lower = string.lower(t.Name), slot = #list + 1 }
        end
    end
    Moves = list
end

task.spawn(function()
    while Claude.Alive do
        pcall(scanMoves, false)
        task.wait(1)
    end
end)

local function findMove(words)
    for _, m in ipairs(Moves) do
        for _, w in ipairs(words) do
            if string.find(m.lower, w, 1, true) then
                return m
            end
        end
    end
    return nil
end

local GOJO_MOVES = {
    { key = "GojoBlue", words = { "blue", "lapse" } },
    { key = "GojoRed", words = { "red", "reversal" } },
    { key = "GojoPurple", words = { "purple", "hollow" } },
}
local GOJO_DOMAIN = { "unlimited", "domain", "void" }
local YUJI_MOVES = {
    { key = "YujiDivergent", words = { "divergent" } },
    { key = "YujiBlackFlash", words = { "black flash", "blackflash", "flash" } },
    { key = "YujiManji", words = { "manji", "kick" } },
}

local function buildSeq(list)
    local seq = {}
    for _, g in ipairs(list) do
        if S[g.key] then
            local m = findMove(g.words)
            if m then seq[#seq + 1] = m end
        end
    end
    return seq
end

-- Мгновенно наводит камеру на цель перед кастом (для снарядов Red / Purple)
local function snapAim()
    if not S.SnapAim then return end
    local cam = Workspace.CurrentCamera
    if cam and Target and TargetRoot and TargetRoot.Parent then
        local aim = TargetRoot.Position + TargetRoot.AssemblyLinearVelocity * (S.Predict / 100)
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aim)
    end
end

local function castMove(m)
    if not m then return false end
    snapAim()
    if S.CastMethod == "Tool Activate" then
        local char = LocalPlayer.Character
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local hum = getHum()
        local tool = (char and char:FindFirstChild(m.name)) or (bp and bp:FindFirstChild(m.name))
        if tool and tool:IsA("Tool") and hum then
            pcall(function() hum:EquipTool(tool) end)
            task.wait(0.03)
            pcall(function() tool:Activate() end)
        end
    else
        local code = SLOT_KEYS[m.slot]
        if code then tapKey(code, 0.05) end
    end
    return true
end

local gojoIdx, yujiIdx = 0, 0
local lastDomain = 0
task.spawn(function()
    while Claude.Alive do
        task.wait(math.max(S.ComboDelay / 1000, 0.08))
        if S.GojoCombo or S.YujiCombo or S.GojoDomain then
            local d = targetDistance()
            if d and d <= S.ComboRange then
                -- Авто-домен Gojo с интервалом, чтобы не спамить
                if S.GojoDomain and os.clock() - lastDomain > 12 then
                    local m = findMove(GOJO_DOMAIN)
                    if m then
                        lastDomain = os.clock()
                        pcall(castMove, m)
                        task.wait(0.3)
                    end
                end
                -- Комбо Gojo: Blue -> Red -> Purple по кругу
                if S.GojoCombo then
                    local seq = buildSeq(GOJO_MOVES)
                    if #seq > 0 then
                        gojoIdx = gojoIdx % #seq + 1
                        pcall(castMove, seq[gojoIdx])
                    end
                end
                -- Комбо Yuji: серия ударов, затем ход (Divergent / Black Flash / Manji)
                if S.YujiCombo then
                    for _ = 1, S.YujiM1Count do
                        pcall(doClick)
                        task.wait(0.11)
                    end
                    local seq = buildSeq(YUJI_MOVES)
                    if #seq > 0 then
                        yujiIdx = yujiIdx % #seq + 1
                        pcall(castMove, seq[yujiIdx])
                    end
                end
            end
        end
    end
end)

-- ========== РАСШИРЕНИЕ ХИТБОКСОВ ==========
local hbOrig = {}

local function restoreHitboxes()
    for root, o in pairs(hbOrig) do
        if root and root.Parent then
            pcall(function()
                root.Size = o.Size
                root.Transparency = o.Transparency
                root.CanCollide = o.CanCollide
            end)
        end
        hbOrig[root] = nil
    end
end

task.spawn(function()
    while Claude.Alive do
        task.wait(0.25)
        if S.Hitbox then
            for root in pairs(hbOrig) do
                if not root.Parent then hbOrig[root] = nil end
            end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local _, r = alive(plr)
                    if r then
                        if not hbOrig[r] then
                            hbOrig[r] = { Size = r.Size, Transparency = r.Transparency, CanCollide = r.CanCollide }
                        end
                        pcall(function()
                            r.Size = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
                            r.Transparency = 0.8
                            r.CanCollide = false
                        end)
                    end
                end
            end
        elseif next(hbOrig) then
            restoreHitboxes()
        end
    end
end)

