-- ========== ВЫБОР ЦЕЛИ ==========
local Target, TargetRoot = nil, nil

local function screenDist(cam, pos)
    local v, on = cam:WorldToViewportPoint(pos)
    if not on or v.Z <= 0 then return nil end
    local c = cam.ViewportSize / 2
    return (Vector2.new(v.X, v.Y) - c).Magnitude
end

local function selectTarget()
    local cam = Workspace.CurrentCamera
    local myRoot = getRoot()
    if not cam or not myRoot then
        Target, TargetRoot = nil, nil
        return
    end

    -- Ручная цель имеет приоритет
    if ManualTarget then
        local _, r = alive(ManualTarget)
        if r and ManualTarget.Parent then
            Target, TargetRoot = ManualTarget, r
            return
        else
            ManualTarget = nil
        end
    end

    -- Липкость: держим текущую цель, пока она подходит
    if Target and Target.Parent then
        local _, r = alive(Target)
        if r then
            local d = (r.Position - myRoot.Position).Magnitude
            local okFov = true
            if S.TargetMode == "Прицел" then
                local sd = screenDist(cam, r.Position)
                okFov = (sd ~= nil) and (sd <= S.FOVRadius * 1.4)
            end
            if d <= S.TargetRange * 1.2 and okFov then
                TargetRoot = r
                return
            end
        end
    end

    -- Поиск новой цели
    local best, bestRoot, bestScore = nil, nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local _, r, hm = alive(plr)
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d <= S.TargetRange then
                    local score = nil
                    if S.TargetMode == "Прицел" then
                        local sd = screenDist(cam, r.Position)
                        if sd and sd <= S.FOVRadius then
                            score = sd
                        end
                    elseif S.TargetMode == "Слабейший HP" then
                        score = hm.Health
                    else
                        score = d
                    end
                    if score and score < bestScore then
                        best, bestRoot, bestScore = plr, r, score
                    end
                end
            end
        end
    end
    Target, TargetRoot = best, bestRoot
end

local targetTimer = 0
track(RunService.Heartbeat:Connect(function(dt)
    targetTimer += dt
    if targetTimer >= 0.1 then
        targetTimer = 0
        pcall(selectTarget)
    end
end))

