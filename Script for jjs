        ui.banner_.TextColor3 = ok and C.good or C.danger
        ui.banner_.TextSize = 8
        ui.banner_.TextTransparency = 1
        tween(ui.banner_, 0.4, { TextSize = 16, TextTransparency = 0 }, Enum.EasingStyle.Back)
    end

    function ui.spinStart()
        if ui.spin then pcall(function() ui.spin:Cancel() end) end
        ui.logo.Rotation = 0
        ui.spin = TweenService:Create(
            ui.logo,
            TweenInfo.new(1.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
            { Rotation = 360 }
        )
        ui.spin:Play()
    end

    function ui.spinStop()
        if ui.spin then pcall(function() ui.spin:Cancel() end) end
        ui.spin = nil
    end

    function ui.show(list)
        local inList = {}
        for _, n in ipairs(list) do inList[n] = true end
        for _, name in ipairs(METHOD_ORDER) do
            if inList[name] then
                ui.setRow(name, "pending", "ожидание")
            else
                ui.setRow(name, "skip", "пропуск")
            end
        end
        ui.setProgress(0, "")
        ui.banner_.TextTransparency = 1
        ui.banner_.TextSize = 8
        ui.showing = true
        panel.Position = UDim2.new(0.5, 0, 0, 24)
        panel.Visible = true
        tween(panel, 0.4, { GroupTransparency = 0, Position = UDim2.new(0.5, 0, 0, 64) }, Enum.EasingStyle.Back)
    end

    function ui.hide()
        ui.showing = false
        tween(panel, 0.35, { GroupTransparency = 1, Position = UDim2.new(0.5, 0, 0, 40) }, Enum.EasingStyle.Quad)
        task.delay(0.4, function()
            if not ui.showing and panel.Parent then panel.Visible = false end
        end)
    end

    BUI = ui
    return ui
end

-- Проверка: остался ли персонаж в точке назначения
local function verifyStay(target, startPos, ui)
    local observe = S.BypassObserve
    local t0 = os.clock()
    while os.clock() - t0 < observe do
        task.wait(0.05)
        local elapsed = os.clock() - t0
        ui.setProgress(elapsed / observe, string.format("%.1f / %d c", elapsed, observe))
        local hum, root = getHum(), getRoot()
        if not hum or not root then return false, "персонаж пропал" end
        if hum.Health <= 0 then return false, "убит античитом" end
        if (root.Position - target.Position).Magnitude > S.BypassTol then
            if (root.Position - startPos).Magnitude <= S.BypassTol * 1.5 then
                return false, "откатило назад"
            end
            return false, "сдвинуло в другое место"
        end
    end
    ui.setProgress(1, string.format("%d / %d c", observe, observe))
    return true, nil
end

-- Запуск теста: list = список методов (по порядку). На первом успехе останавливаемся.
function Bypass.runTests(list)
    if Bypass.testing then
        notify("Тест уже идёт")
        return
    end
    if not getRoot() then
        notify("Нет персонажа")
        return
    end
    Bypass.testing = true
    task.spawn(function()
        local ui = ensureBypassUI()
        local okAll, err = pcall(function()
            ui.show(list)
            ui.spinStart()
            local winner, winnerStart = nil, nil
            for _, name in ipairs(list) do
                if not Claude.Alive then break end
                local hum, root = getHum(), getRoot()
                if not hum or not root or hum.Health <= 0 then
                    ui.setRow(name, "fail", "нет персонажа")
                    break
                end
                local startCF = root.CFrame
                local target = randomGround(startCF.Position)
                if not target then
                    ui.setRow(name, "fail", "нет безопасной точки")
                    continue
                end

                ui.setRow(name, "testing", "телепорт...")
                showMarker(target.Position, C.accent2)
                flash(C.accent)
                local okRun = pcall(TPMethods[name], target)
                if not okRun then
                    ui.setRow(name, "fail", "ошибка метода")
                    setMarkerColor(C.danger)
                    continue
                end

                ui.setRow(name, "testing", "наблюдаю...")
                local stayed, why = verifyStay(target, startCF.Position, ui)
                if stayed then
                    ui.setRow(name, "ok", "ОСТАЛСЯ")
                    setMarkerColor(C.good)
                    flash(C.good)
                    winner, winnerStart = name, startCF
                    break
                else
                    ui.setRow(name, "fail", why or "откатило")
                    setMarkerColor(C.danger)
                    flash(C.danger)
                    task.wait(0.8)
                end
            end

            if winner then
                Bypass.method = winner
                Bypass.failedAll = false
                ui.banner(true, "BYPASS ОК: " .. winner)
                notify("Bypass найден: " .. winner)
                if S.BypassReturn and winnerStart then
                    task.wait(1.2)
                    pcall(TPMethods[winner], winnerStart)
                end
            else
                if #list > 1 then
                    Bypass.method = nil
                    Bypass.failedAll = true
                end
                ui.banner(false, "Bypass не найден")
                notify("Bypass не найден")
            end
            if Bypass.onStatus then pcall(Bypass.onStatus) end
            task.wait(3.2)
        end)
        if not okAll then
            warn("[Claude] Ошибка теста bypass: " .. tostring(err))
            notify("Ошибка теста, смотри консоль")
        end
        clearMarker(true)
        ui.spinStop()
        ui.hide()
        Bypass.testing = false
    end)
end

