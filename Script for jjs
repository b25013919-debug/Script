-- ========== STICK: ТЕЛЕПОРТ-ПРИЛИПАНИЕ К ЦЕЛИ ==========
local orbitAngle = 0
track(RunService.Heartbeat:Connect(function(dt)
    if not S.Stick then return end
    local myRoot = getRoot()
    if not myRoot or not Target or not TargetRoot or not TargetRoot.Parent then return end

    local tPos = TargetRoot.Position
    local pos
    if S.StickMode == "Сзади" then
        pos = (TargetRoot.CFrame * CFrame.new(0, S.StickHeight, S.StickDist)).Position
    elseif S.StickMode == "Спереди" then
        pos = (TargetRoot.CFrame * CFrame.new(0, S.StickHeight, -S.StickDist)).Position
    else
        orbitAngle = (orbitAngle + math.rad(S.OrbitSpeed) * dt) % (math.pi * 2)
        pos = tPos + Vector3.new(math.cos(orbitAngle) * S.StickDist, S.StickHeight, math.sin(orbitAngle) * S.StickDist)
    end

    local look = Vector3.new(tPos.X, pos.Y, tPos.Z)
    if (look - pos).Magnitude < 0.05 then return end
    myRoot.CFrame = CFrame.lookAt(pos, look)
    myRoot.AssemblyLinearVelocity = Vector3.zero
end))

