-- Случайная точка на земле вокруг origin (проверяем лучом, чтобы не попасть в войд)
local function randomGround(origin)
    local filter = { Claude.Markers }
    if LocalPlayer.Character then filter[#filter + 1] = LocalPlayer.Character end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    local lo, hi = math.min(S.BypassMin, S.BypassMax), math.max(S.BypassMin, S.BypassMax)
    for _ = 1, 20 do
        local ang = math.random() * math.pi * 2
        local dist = lo + math.random() * (hi - lo)
        local p = origin + Vector3.new(math.cos(ang) * dist, 0, math.sin(ang) * dist)
        local res = Workspace:Raycast(p + Vector3.new(0, 300, 0), Vector3.new(0, -700, 0), params)
        if res and res.Instance and res.Instance.CanCollide and res.Normal.Y > 0.7 then
            return CFrame.new(res.Position + Vector3.new(0, 3.5, 0))
        end
    end
    return nil
end

-- Методы телепорта
local TPMethods = {}

-- Обычная установка CFrame
TPMethods["Прямой"] = function(cf)
    local r = getRoot()
    if r then
        r.CFrame = cf
        r.AssemblyLinearVelocity = Vector3.zero
    end
end

-- Несколько кадров подряд с обнулением скорости
TPMethods["Импульсный"] = function(cf)
    for _ = 1, 6 do
        local r = getRoot()
        if r then
            r.CFrame = cf
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
        task.wait()
    end
end

-- Быстрые шаги по 14 студов за кадр (выглядит как очень быстрый бег)
TPMethods["Шаговый"] = function(cf)
    local step = 14
    for _ = 1, 400 do
        if not Claude.Alive then return end
        local r = getRoot()
        if not r then return end
        local delta = cf.Position - r.Position
        if delta.Magnitude <= step then
            r.CFrame = cf
            r.AssemblyLinearVelocity = Vector3.zero
            return
        end
        r.CFrame = r.CFrame + delta.Unit * step
        r.AssemblyLinearVelocity = Vector3.zero
        task.wait()
    end
end

-- Персонаж умирает, а после респавна сразу ставится в нужную точку
TPMethods["Через смерть"] = function(cf)
    local hum = getHum()
    local char = LocalPlayer.Character
    if not hum or not char then return end
    local newChar = nil
    local conn = LocalPlayer.CharacterAdded:Connect(function(c) newChar = c end)
    pcall(function() hum.Health = 0 end)
    pcall(function() char:BreakJoints() end)
    local t0 = os.clock()
    while not newChar and os.clock() - t0 < 12 and Claude.Alive do
        task.wait(0.1)
    end
    conn:Disconnect()
    if not newChar then return end
    local root = newChar:WaitForChild("HumanoidRootPart", 6)
    if not root then return end
    local t1 = os.clock()
    while os.clock() - t1 < 0.8 and Claude.Alive do
        if root.Parent then
            root.CFrame = cf
            root.AssemblyLinearVelocity = Vector3.zero
        end
        task.wait()
    end
end

local function effectiveMethod()
    if S.TPMethod ~= "Авто" then return S.TPMethod end
    return Bypass.method or "Импульсный"
end

-- ТП через выбранный (или найденный) метод, используется во всём скрипте
