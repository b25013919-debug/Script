track(RunService.RenderStepped:Connect(function()
    if not HUD.ready then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize

    -- FOV-круг и прицел
    local showFov = S.ShowFOV and S.TargetMode == "Прицел"
    HUD.fov.Visible = showFov
    if showFov then
        local sz = S.FOVRadius * 2
        HUD.fov.Size = UDim2.fromOffset(sz, sz)
        HUD.fovStroke.Color = (Target and TargetRoot) and C.good or C.accent
    end
    HUD.cross.Visible = S.Crosshair

    -- Карточка цели
    local show = false
    local r, h
    if S.TargetHUD and Target and TargetRoot and TargetRoot.Parent then
        local _
        _, r, h = alive(Target)
        show = (r ~= nil)
    end
    if show then
        if not cardShown then
            cardShown = true
            HUD.card.Visible = true
            tween(HUD.card, 0.25, { GroupTransparency = 0 })
        end
        HUD.name.Text = Target.DisplayName
        local ratio = math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1)
        shownRatio = shownRatio + (ratio - shownRatio) * 0.2
        HUD.hpFill.Size = UDim2.new(shownRatio, 0, 1, 0)
        HUD.hpFill.BackgroundColor3 = Color3.fromHSV(0.33 * shownRatio, 0.75, 1)
        local myRoot = getRoot()
        local d = myRoot and math.floor((r.Position - myRoot.Position).Magnitude) or 0
        HUD.info.Text = string.format("%d / %d HP  |  %d st", math.floor(h.Health), math.floor(h.MaxHealth), d)
    elseif cardShown then
        cardShown = false
        tween(HUD.card, 0.25, { GroupTransparency = 1 })
        task.delay(0.27, function()
            if not cardShown and HUD.card then HUD.card.Visible = false end
        end)
    end

    -- Трассеры
    if S.Tracers then
        tracersWereOn = true
        local origin = Vector2.new(vp.X / 2, vp.Y)
        local rainbow = Color3.fromHSV((os.clock() * 0.2) % 1, 0.75, 1)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local _, root = alive(plr)
                local line = HUD.tracers[plr]
                local drawn = false
                if root then
                    local v = cam:WorldToViewportPoint(root.Position)
                    if v.Z > 0 then
                        if not line then
                            line = new("Frame", {
                                AnchorPoint = Vector2.new(0.5, 0.5),
                                BorderSizePixel = 0,
                                ZIndex = 2,
                            }, HUD.layer)
                            HUD.tracers[plr] = line
                        end
                        local p = Vector2.new(v.X, v.Y)
                        local delta = p - origin
                        local mid = origin + delta / 2
                        line.Size = UDim2.fromOffset(delta.Magnitude, S.TracerThickness)
                        line.Position = UDim2.fromOffset(mid.X, mid.Y)
                        line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                        line.BackgroundColor3 = (plr == Target) and C.good or (S.ESPRainbow and rainbow or C.accent)
                        line.BackgroundTransparency = 0.25
                        line.Visible = true
                        drawn = true
                    end
                end
                if not drawn and line then
                    line.Visible = false
                end
            end
        end
    elseif tracersWereOn then
        tracersWereOn = false
        for plr in pairs(HUD.tracers) do removeTracer(plr) end
    end
end))

